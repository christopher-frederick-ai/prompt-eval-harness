# Copy to .env (which is git-ignored) and fill in. Never commit real values.

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_CHAT_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional: judge with a different deployment than the one being evaluated (reduces self-preference bias)
# JUDGE_DEPLOYMENT=<another-deployment>

# Optional: lower hidden reasoning (minimal | low | medium | high). Reasoning models only
# (e.g. gpt-5-mini). Leave UNSET for gpt-4o, which rejects this parameter.
# REASONING_EFFORT=low

# USD per 1M tokens for the model being evaluated. SET THESE to match your deployment.
# gpt-4o list prices (cached input is $1.25, but it is not applied here: caching needs prompts
# of 1,024+ tokens and these prompts are ~100):
PRICE_IN_PER_M=2.50
PRICE_OUT_PER_M=10.00
# gpt-5-mini (assumed, verify): PRICE_IN_PER_M=0.25  PRICE_OUT_PER_M=2.00

# USD per 1M tokens for the JUDGE deployment, if it differs from the model above. Without
# these the report charges judge calls at the generator's prices and warns you.
# gpt-5-mini values below are ASSUMED: verify on your Azure pricing page.
# JUDGE_PRICE_IN_PER_M=0.25
# JUDGE_PRICE_OUT_PER_M=2.00

# Optional LangSmith tracing (traces every call, tagged by variant)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=<your-langsmith-key>
# LANGCHAIN_PROJECT=prompt-eval-harness
